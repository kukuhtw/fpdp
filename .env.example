APP_NAME=FPDP
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fpdp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

NODE_DOMAIN=localhost
NODE_NAME=FPDP Node
NODE_DEFAULT_LOCALE=id
NODE_TIMEZONE=Asia/Jakarta
AUTH_TOKEN_TTL=604800

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=3600

# Long random secret used to sign OAuth state parameters. Generate with:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VISITOR_TOKEN_TTL=2592000

CV_MAX_FILE_SIZE_BYTES=5242880

# Gateway used for CV/resume paid-access checkout (DUMMY grants synchronously
# for local dev; PAYWUZ waits for the transaction.paid webhook before granting).
CV_PAYMENT_GATEWAY=DUMMY

# Paywuz Merchant API v1 (https://api.paywuz.id/v1). Required only when
# CV_PAYMENT_GATEWAY=PAYWUZ or any code calls PaymentGatewayFactory with PAYWUZ.
# Also used as the HMAC-SHA256 secret to verify the X-Paywuz-Signature header
# on POST /api/v1/payments/webhook/paywuz.
PAYWUZ_API_KEY=
PAYWUZ_API_URL=https://api.paywuz.id/v1

# Midtrans Snap + Core API (docs.midtrans.com). Sandbox by default; set
# MIDTRANS_ENVIRONMENT=PRODUCTION once ready to go live with a production
# Server Key. Used both to call the API and to verify the signature_key
# field on inbound POST /api/v1/payments/webhook/midtrans notifications.
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=SANDBOX
