# Deny direct access to dotfiles served from this directory (defense in depth;
# the real .env lives outside public/ and is never served either way).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Pass the Authorization header through to PHP (Apache/mod_rewrite may strip it
# otherwise, even with mod_php; this rule re-injects it as an environment
# variable so PHP sees it in $_SERVER['HTTP_AUTHORIZATION']).
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Serve existing files and directories (css/js/images, install.php itself) as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller.
RewriteRule ^ index.php [L]
