APP_NAME=FPDP
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
APP_KEY=replace-with-64-or-more-random-hex-characters

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fpdp
DB_USERNAME=fpdp
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DB_CHARSET=utf8mb4

NODE_DOMAIN=example.com
NODE_NAME=FPDP Node
NODE_DEFAULT_LOCALE=id
NODE_TIMEZONE=Asia/Jakarta
AUTH_TOKEN_TTL=604800

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=3600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VISITOR_TOKEN_TTL=2592000
CV_MAX_FILE_SIZE_BYTES=5242880

# First deployment only. Remove the password after the owner is created.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_OWNER_HANDLE=profile
BOOTSTRAP_OWNER_DISPLAY_NAME=Node Owner
BOOTSTRAP_OWNER_LOCALE=id


# Long random secret used to sign OAuth state parameters AND to derive the
# AES-256-GCM key that encrypts payment gateway credentials stored via
# PATCH /api/v1/me/payment-gateways/{code} (payment_gateway_configs table).
# Generate with:
# php -r "echo bin2hex(random_bytes(32));"
# Rotating this value makes previously-stored gateway credentials
# undecryptable (they are skipped, not fatal) — re-enter them after rotating.


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VISITOR_TOKEN_TTL=2592000

CV_MAX_FILE_SIZE_BYTES=5242880

# Gateway used for CV/resume paid-access checkout (DUMMY grants synchronously
# for local dev; PAYWUZ waits for the transaction.paid webhook before granting).
CV_PAYMENT_GATEWAY=DUMMY

# Paywuz Merchant API v1 (https://api.paywuz.id/v1). Fallback only — these
# are used when no credentials have been configured via the API
# (PATCH /api/v1/me/payment-gateways/paywuz), which takes priority and
# stores the key encrypted in the DB instead. Also used as the HMAC-SHA256
# secret to verify X-Paywuz-Signature on POST /api/v1/payments/webhook/paywuz
# when configured this way.
PAYWUZ_API_KEY=
PAYWUZ_API_URL=https://api.paywuz.id/v1

# Midtrans Snap + Core API (docs.midtrans.com). Fallback only — same
# API-config-takes-priority behavior as Paywuz above
# (PATCH /api/v1/me/payment-gateways/midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=SANDBOX

# PayPal Orders API v2 (developer.paypal.com/docs/api/orders/v2). Fallback
# only — same API-config-takes-priority behavior as above
# (PATCH /api/v1/me/payment-gateways/paypal). PAYPAL_WEBHOOK_ID comes from
# the webhook subscription created in the PayPal developer dashboard and is
# required to verify POST /api/v1/payments/webhook/paypal. PayPal cannot
# receive payments in IDR — pass a supported currency (defaults to USD)
# when creating a PayPal payment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=SANDBOX
